<Window x:Class="PCBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Buddy" Width="1180" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="4,10,4,22">
                    <TextBlock Text="PC BUDDY" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Portable local companion" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,4">
                    <Border Background="#111419" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="PortableModeText" Text="Portable data mode" FontSize="12" />
                            <TextBlock x:Name="VersionText" Text="v0.2.0-alpha" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Tag="Home" Click="Nav_Click" Content="⌂   Home" />
                    <Button Style="{StaticResource NavButton}" Tag="Chat" Click="Nav_Click" Content="●   Buddy Chat" />
                    <Button Style="{StaticResource NavButton}" Tag="Access" Click="Nav_Click" Content="▣   Access" />
                    <Button Style="{StaticResource NavButton}" Tag="Activity" Click="Nav_Click" Content="≡   Activity" />
                    <Button Style="{StaticResource NavButton}" Tag="Settings" Click="Nav_Click" Content="⚙   Settings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="26,0,26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Home" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="Local tools and GPT connection at a glance" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusPill" Background="{StaticResource AccentDarkBrush}" CornerRadius="14" Padding="11,6" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="HeaderStatusText" Text="LOCAL READY" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                </Border>
                <Button Grid.Column="2" x:Name="EmergencyButton" Style="{StaticResource DangerButton}" Padding="13,8" Content="Emergency Lock" Click="EmergencyLock_Click" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" Margin="26,0,26,24">
                <Grid x:Name="HomePage">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="KeyNeededBanner" Visibility="Collapsed" Background="#33281B" BorderBrush="#70562E" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="One-time OpenAI connection needed" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="Paste an API key once in Settings. PC Buddy encrypts it with your Windows account. No terminal and no ChatGPT custom-app setup." Foreground="#D7C7A7" TextWrapping="Wrap" Margin="0,4,12,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Set it up" Click="NavSettings_Click" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PC Buddy Direct" FontSize="26" FontWeight="Bold" />
                                        <TextBlock Text="GPT-5.6 Sol + your approved Windows tools, directly in one portable app." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,8,0"><TextBlock Text="No Node" Foreground="{StaticResource AccentBrush}" FontSize="11"/></Border>
                                            <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,8,0"><TextBlock Text="No terminal" Foreground="{StaticResource AccentBrush}" FontSize="11"/></Border>
                                            <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="8" Padding="9,5"><TextBlock Text="No ChatGPT app settings" Foreground="{StaticResource AccentBrush}" FontSize="11"/></Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Open Buddy Chat" Click="GoChat_Click" VerticalAlignment="Center" Padding="20,12" />
                                </Grid>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,14">
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                                    <StackPanel><TextBlock Text="OpenAI" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OpenAiStatusText" Text="Not connected" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="4,0">
                                    <StackPanel><TextBlock Text="Local tools" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LocalToolsStatusText" Text="Ready" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                                    <StackPanel><TextBlock Text="Access policy" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AccessStatusText" Text="Read-only" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="What Buddy can do now" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="• Inspect enabled Desktop/Documents folders read-only   • See visible apps and process summaries   • Run only explicitly enabled Windows diagnostics   • Search the web when enabled   • Keep conversation state across restarts" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ChatPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox x:Name="ChatList" Grid.Row="0" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="2">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Focusable" Value="False"/></Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Bubble" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,5" HorizontalAlignment="Left" MaxWidth="720">
                                    <StackPanel>
                                        <TextBlock x:Name="RoleText" Text="PC BUDDY" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" Margin="0,0,0,5" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="21" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Bubble" Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                        <Setter TargetName="RoleText" Property="Text" Value="YOU" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInput" MinHeight="72" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="ChatInput_PreviewKeyDown" BorderThickness="0" Background="Transparent" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Bottom">
                                <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Content="Send" Click="Send_Click" Width="92" />
                                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Stop" Click="Cancel_Click" Width="92" Margin="0,7,0,0" Visibility="Collapsed" />
                                <Button Style="{StaticResource SecondaryButton}" Content="New chat" Click="NewChat_Click" Width="92" Margin="0,7,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="AccessPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Allowed folders" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="PC Buddy can only read files inside folders you enable here. This portable build has no file-write tool." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <CheckBox x:Name="DesktopCheck" Content="Desktop" />
                                    <CheckBox x:Name="DocumentsCheck" Content="Documents" />
                                    <CheckBox x:Name="DownloadsCheck" Content="Downloads" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Computer visibility" FontSize="18" FontWeight="SemiBold" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,10,0,18">
                                <StackPanel>
                                    <CheckBox x:Name="ProcessCheck" Content="Let Buddy see visible application windows and process summaries" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Allowed diagnostics" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="These are fixed commands. Buddy cannot submit arbitrary shell or PowerShell text." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <CheckBox x:Name="IdentityCheck" Content="whoami — Windows account identity" />
                                    <CheckBox x:Name="HostnameCheck" Content="hostname — computer name" />
                                    <CheckBox x:Name="IpConfigCheck" Content="ipconfig /all — network diagnostics" />
                                    <CheckBox x:Name="SystemInfoCheck" Content="systeminfo — extended Windows information" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Save access policy" Click="SaveAccess_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ActivityPage" Visibility="Collapsed">
                    <ListBox ItemsSource="{Binding Activities}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Tool}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="OpenAI connection" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Direct mode uses the OpenAI API and API billing, separately from a ChatGPT subscription. If OPENAI_API_KEY already exists on Windows, Buddy uses it automatically." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="API key" Foreground="{StaticResource MutedBrush}" />
                                    <PasswordBox x:Name="ApiKeyBox" Margin="0,7,0,10" />
                                    <WrapPanel>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Save &amp; test" Click="SaveKey_Click" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Open API keys page" Click="OpenApiKeys_Click" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Forget saved key" Click="ForgetKey_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="KeyStatusText" Text="No saved key" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Buddy model" FontSize="18" FontWeight="SemiBold" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,10,0,18">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Model" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="ModelCombo" Margin="0,6,0,0"><ComboBoxItem Content="gpt-5.6-sol"/><ComboBoxItem Content="gpt-5.6-terra"/><ComboBoxItem Content="gpt-5.6-luna"/></ComboBox></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Reasoning" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="ReasoningCombo" Margin="0,6,0,0"><ComboBoxItem Content="low"/><ComboBoxItem Content="medium"/><ComboBoxItem Content="high"/><ComboBoxItem Content="xhigh"/><ComboBoxItem Content="max"/></ComboBox></StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom"><CheckBox x:Name="WebSearchCheck" Content="Allow OpenAI web search"/><CheckBox x:Name="AutoStartCheck" Content="Start PC Buddy when I sign in to Windows"/></StackPanel>
                                    </Grid>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Save Buddy settings" Click="SaveSettings_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Portable data" FontSize="18" FontWeight="SemiBold" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,10,0,18">
                                <StackPanel>
                                    <TextBlock x:Name="DataPathText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Open data folder" Click="OpenData_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Optional ChatGPT subscription link" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Not required for PC Buddy Direct. This only opens OpenAI's supported connector page if you later want this same local toolset inside ChatGPT too." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Open ChatGPT connector settings" Click="OpenChatGptConnector_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
