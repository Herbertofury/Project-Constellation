<Window x:Class="PCBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Buddy" Width="1220" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="4,10,4,22">
                    <TextBlock Text="PC BUDDY" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="ChatGPT + your PC" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,4">
                    <Border Background="#111419" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="PortableModeText" Text="Portable data mode" FontSize="12" />
                            <TextBlock x:Name="VersionText" Text="v0.3.0-session" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Tag="Home" Click="Nav_Click" Content="⌂   Home" />
                    <Button Style="{StaticResource NavButton}" Tag="Chat" Click="Nav_Click" Content="●   Buddy Chat" />
                    <Button Style="{StaticResource NavButton}" Tag="Access" Click="Nav_Click" Content="▣   Access" />
                    <Button Style="{StaticResource NavButton}" Tag="Activity" Click="Nav_Click" Content="≡   Activity" />
                    <Button Style="{StaticResource NavButton}" Tag="Settings" Click="Nav_Click" Content="⚙   Settings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="26,0,26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Home" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="Your normal ChatGPT session with guarded local PC tools" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusPill" Background="{StaticResource AccentDarkBrush}" CornerRadius="14" Padding="11,6" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="HeaderStatusText" Text="STARTING" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                </Border>
                <Button Grid.Column="2" x:Name="EmergencyButton" Style="{StaticResource DangerButton}" Padding="13,8" Content="Emergency Lock" Click="EmergencyLock_Click" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" Margin="26,0,26,24">
                <Grid x:Name="HomePage">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PC Buddy Session" FontSize="26" FontWeight="Bold" />
                                        <TextBlock Text="Runs the real ChatGPT website inside Buddy using your normal ChatGPT login — not the separately billed OpenAI API." Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,20,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,8,0"><TextBlock Text="No API key" Foreground="{StaticResource AccentBrush}" FontSize="11"/></Border>
                                            <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,8,0"><TextBlock Text="No API credits" Foreground="{StaticResource AccentBrush}" FontSize="11"/></Border>
                                            <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="8" Padding="9,5"><TextBlock Text="No terminal" Foreground="{StaticResource AccentBrush}" FontSize="11"/></Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Open Buddy Chat" Click="GoChat_Click" VerticalAlignment="Center" Padding="20,12" />
                                </Grid>
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,14">
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                                    <StackPanel><TextBlock Text="ChatGPT session" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ChatSessionHomeStatusText" Text="Starting…" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="4,0">
                                    <StackPanel><TextBlock Text="Local tools" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LocalToolsStatusText" Text="Ready" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                                    <StackPanel><TextBlock Text="Access policy" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AccessStatusText" Text="Read-only guarded" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="How this build works" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="ChatGPT stays ChatGPT: your account, chats, model picker, subscription limits, and web UI are all the normal site. PC Buddy only adds a guarded local-tool bridge beside that session. The first launch may ask you to sign in to ChatGPT inside Buddy once; that login is then kept in Buddy's portable profile." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ChatPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ChatSessionStatusText" Text="Starting ChatGPT session…" FontWeight="SemiBold" />
                                <TextBlock Text="This is your normal ChatGPT web session. Buddy's internal bridge messages are hidden from view." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="ReloadChatButton" Style="{StaticResource SecondaryButton}" Content="Reload ChatGPT" Click="ReloadChat_Click" Margin="0,0,8,0" />
                                <Button x:Name="NewBuddyChatButton" Style="{StaticResource PrimaryButton}" Content="New Buddy chat" Click="NewBuddyChat_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="#090B0E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid x:Name="ChatHost" />
                    </Border>
                </Grid>

                <Grid x:Name="AccessPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Allowed folders" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="PC Buddy can only read files inside folders you enable here. This build has no arbitrary file-write or shell tool." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <CheckBox x:Name="DesktopCheck" Content="Desktop" />
                                    <CheckBox x:Name="DocumentsCheck" Content="Documents" />
                                    <CheckBox x:Name="DownloadsCheck" Content="Downloads" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Computer visibility" FontSize="18" FontWeight="SemiBold" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,10,0,18">
                                <CheckBox x:Name="ProcessCheck" Content="Let Buddy see visible application windows and process summaries" />
                            </Border>

                            <TextBlock Text="Allowed diagnostics" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="These are fixed commands. ChatGPT cannot submit arbitrary shell or PowerShell text." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <CheckBox x:Name="IdentityCheck" Content="whoami — Windows account identity" />
                                    <CheckBox x:Name="HostnameCheck" Content="hostname — computer name" />
                                    <CheckBox x:Name="IpConfigCheck" Content="ipconfig /all — network diagnostics" />
                                    <CheckBox x:Name="SystemInfoCheck" Content="systeminfo — extended Windows information" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Save access policy" Click="SaveAccess_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ActivityPage" Visibility="Collapsed">
                    <ListBox ItemsSource="{Binding Activities}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Tool}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="ChatGPT session" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="There is no OpenAI API key in this build. Buddy stores a dedicated ChatGPT browser profile beside its portable data so you can sign in once and keep using your normal ChatGPT account." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock x:Name="SessionProfilePathText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Open Buddy Chat" Click="GoChat_Click" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Open ChatGPT in browser" Click="OpenChatGptBrowser_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Startup" FontSize="18" FontWeight="SemiBold" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,10,0,18">
                                <StackPanel>
                                    <CheckBox x:Name="AutoStartCheck" Content="Start PC Buddy when I sign in to Windows" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="Save Buddy settings" Click="SaveSettings_Click" HorizontalAlignment="Left" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Portable data" FontSize="18" FontWeight="SemiBold" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="DataPathText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="Open data folder" Click="OpenData_Click" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
