{
  "manifest_version": 3,
  "name": "Project Constellation",
  "version": "0.24.0",
  "minimum_chrome_version": "116",
  "description": "Agent monitoring with durable trouble alerts, sound, a shared Rust browser hub, manual approval review, and the Constellation project workspace.",
  "key": "",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "alarms",
    "identity",
    "unlimitedStorage",
    "idle",
    "offscreen",
    "webRequest",
    "scripting",
    "notifications",
    "tabGroups",
    "contextMenus"
  ],
  "optional_permissions": [
    "downloads",
    "history",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://api.github.com/*",
    "https://www.googleapis.com/*",
    "https://github.com/*"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://chat.mistral.ai/*",
    "https://poe.com/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://chat.qwen.ai/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://character.ai/*",
    "https://www.character.ai/*",
    "https://huggingface.co/*",
    "https://you.com/*",
    "https://www.you.com/*",
    "https://pi.ai/*",
    "https://www.pi.ai/*",
    "https://duck.ai/*",
    "http://127.0.0.1:47721/*",
    "http://localhost:47721/*"
  ],
  "oauth2": {
    "client_id": "PROJECT_CONSTELLATION_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background-entry.js",
    "type": "module"
  },
  "action": {
    "default_title": "Constellation \u00b7 Agent Monitor",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/route-observer.js",
        "src/local-work-page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/chatgpt-page-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/scheduled-task-page-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/scheduled-task-observer.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://chat.mistral.ai/*",
        "https://poe.com/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://chat.qwen.ai/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://character.ai/*",
        "https://www.character.ai/*",
        "https://huggingface.co/chat/*",
        "https://you.com/*",
        "https://www.you.com/*",
        "https://pi.ai/*",
        "https://www.pi.ai/*",
        "https://duck.ai/*"
      ],
      "js": [
        "src/core.js",
        "src/brain-core.js",
        "src/provider-core.js",
        "src/provider-health-core.js",
        "src/health-core.js",
        "src/live-sentinel.js",
        "src/tab-beacon.js",
        "src/content.js",
        "src/pulse-ux.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/project-identity-core.js",
        "src/chat-vault-core.js",
        "src/chat-organizer.js"
      ],
      "css": [
        "src/chat-organizer.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/local-work-content.js",
        "src/scheduled-task-recovery-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
