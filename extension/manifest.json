{
  "manifest_version": 3,
  "name": "Project Constellation",
  "version": "0.14.1",
  "minimum_chrome_version": "116",
  "description": "Performance-first AI workspace with live multi-tab Chat Pulse, completion notifications, Execution Pulse + Tool Watchdog, Knowledge Vault, Capacity Guard + editable Branch & Continue, project continuity intelligence, Approval Autopilot, durable chat/file lineage, and verified remote checkpoints.",
  "key": "",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "alarms",
    "identity",
    "unlimitedStorage",
    "idle",
    "offscreen",
    "webRequest",
    "scripting",
    "notifications"
  ],
  "optional_permissions": [
    "downloads",
    "history"
  ],
  "optional_host_permissions": [
    "https://api.github.com/*",
    "https://www.googleapis.com/*",
    "https://github.com/*"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://chat.mistral.ai/*",
    "https://poe.com/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://chat.qwen.ai/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://character.ai/*",
    "https://www.character.ai/*",
    "https://huggingface.co/*",
    "https://you.com/*",
    "https://www.you.com/*",
    "https://pi.ai/*",
    "https://www.pi.ai/*",
    "https://duck.ai/*"
  ],
  "oauth2": {
    "client_id": "PROJECT_CONSTELLATION_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Project Constellation",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://chat.mistral.ai/*",
        "https://poe.com/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://chat.qwen.ai/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://character.ai/*",
        "https://www.character.ai/*",
        "https://huggingface.co/chat/*",
        "https://you.com/*",
        "https://www.you.com/*",
        "https://pi.ai/*",
        "https://www.pi.ai/*",
        "https://duck.ai/*"
      ],
      "js": [
        "src/core.js",
        "src/brain-core.js",
        "src/provider-core.js",
        "src/health-core.js",
        "src/content.js",
        "src/pulse-ux.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_start"
    }
  ]
}
