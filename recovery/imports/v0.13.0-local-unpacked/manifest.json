{
  "manifest_version": 3,
  "name": "Project Constellation",
  "version": "0.13.0",
  "minimum_chrome_version": "116",
  "description": "Performance-first AI workspace with Execution Pulse + Tool Watchdog, Knowledge Vault, Capacity Guard + Safe Handoff, project continuity intelligence, adaptive request governance, Approval Autopilot, durable chat/file lineage, full capture, and verified remote checkpoints.",
  "key": "",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "alarms",
    "identity",
    "unlimitedStorage",
    "idle",
    "offscreen",
    "webRequest"
  ],
  "optional_permissions": [
    "downloads",
    "history"
  ],
  "optional_host_permissions": [
    "https://api.github.com/*",
    "https://www.googleapis.com/*",
    "https://github.com/*"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://chat.mistral.ai/*",
    "https://poe.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Project Constellation",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://chat.mistral.ai/*",
        "https://poe.com/*"
      ],
      "js": [
        "src/core.js",
        "src/brain-core.js",
        "src/provider-core.js",
        "src/health-core.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_start"
    }
  ]
}
