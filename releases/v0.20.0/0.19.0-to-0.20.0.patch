@@ -0,0 +1,90 @@
+name: Project Constellation Unified Release
+
+on:
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: Release tag, for example v0.20.0
+        required: true
+        default: v0.20.0
+  push:
+    tags: ['v*']
+
+permissions:
+  contents: write
+
+env:
+  VERSION: 0.20.0
+
+jobs:
+  verify-linux:
+    uses: ./.github/workflows/ci.yml
+
+  windows-release:
+    uses: ./.github/workflows/windows-runtime.yml
+
+  publish:
+    needs: [verify-linux, windows-release]
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v7
+        with: { fetch-depth: 0 }
+      - uses: actions/setup-node@v7
+        with: { node-version: 24 }
+
+      - name: Reconstruct exact release source
+        shell: bash
+        run: |
+          set -euo pipefail
+          manifest="$GITHUB_WORKSPACE/releases/v0.20.0/SOURCE-MANIFEST.json"
+          test -f "$manifest"
+          baseline=$(node -e "const fs=require('fs');const m=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.stdout.write(m.baseline.artifact)" "$manifest")
+          baseline_sha=$(node -e "const fs=require('fs');const m=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.stdout.write(m.baseline.sha256)" "$manifest")
+          delta=$(node -e "const fs=require('fs');const m=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.stdout.write(m.delta.artifact)" "$manifest")
+          delta_sha=$(node -e "const fs=require('fs');const m=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.stdout.write(m.delta.sha256)" "$manifest")
+          [[ "$(sha256sum "$baseline" | awk '{print $1}')" == "$baseline_sha" ]]
+          [[ "$(sha256sum "$delta" | awk '{print $1}')" == "$delta_sha" ]]
+          root="$GITHUB_WORKSPACE/pc-source"
+          mkdir -p "$root"
+          unzip -q "$baseline" -d "$root"
+          git -C "$root" init -q
+          git -C "$root" config user.name 'Project Constellation Release'
+          git -C "$root" config user.email 'actions@users.noreply.github.com'
+          git -C "$root" config core.autocrlf false
+          git -C "$root" add -A
+          git -C "$root" commit -q -m 'Project Constellation verified production baseline'
+          git -C "$root" apply --cached "$GITHUB_WORKSPACE/$delta"
+          git -C "$root" checkout-index -a -f
+          [[ "$(node -p "require('$root/package.json').version")" == "$VERSION" ]]
+          echo "PC_SOURCE_ROOT=$root" >> "$GITHUB_ENV"
+
+      - uses: actions/download-artifact@v8
+        with:
+          name: Project-Constellation-v0.20.0-Windows
+          path: windows-dist
+
+      - name: Build exact extension and unified release set
+        env:
+          PROJECT_CONSTELLATION_GOOGLE_CLIENT_ID: ${{ secrets.PROJECT_CONSTELLATION_GOOGLE_CLIENT_ID }}
+          PROJECT_CONSTELLATION_GITHUB_CLIENT_ID: ${{ secrets.PROJECT_CONSTELLATION_GITHUB_CLIENT_ID }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          cd "$PC_SOURCE_ROOT"
+          mkdir -p desktop/dist-electron
+          find "$GITHUB_WORKSPACE/windows-dist" -maxdepth 2 -type f -exec cp -f {} desktop/dist-electron/ \;
+          npm ci --no-audit --no-fund
+          if [[ -n "$PROJECT_CONSTELLATION_GOOGLE_CLIENT_ID" && -n "$PROJECT_CONSTELLATION_GITHUB_CLIENT_ID" ]]; then npm run build; else node tools/build.mjs --mode=production --allow-unprovisioned-oauth; fi
+          node tools/package-unified-release.mjs
+
+      - name: Publish immutable GitHub Release
+        env:
+          GH_TOKEN: ${{ github.token }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          TAG="${{ inputs.tag || github.ref_name }}"
+          test "$TAG" = "v${VERSION}"
+          if gh release view "$TAG" >/dev/null 2>&1; then echo "Release $TAG already exists; refusing to mutate immutable published bytes." >&2; exit 1; fi
+          gh release create "$TAG" "$PC_SOURCE_ROOT"/releases/v${VERSION}/* --verify-tag --title "Project Constellation $TAG" --notes-file "$PC_SOURCE_ROOT/docs/v${VERSION}-release-notes.md"
diff --git a/.github/workflows/windows-runtime.yml b/.github/workflows/windows-runtime.yml
new file mode 100644
index 0000000000000000000000000000000000000000..605510a2697b1563700902a12ae0bb3bd5f5fb9c
--- /dev/null
+++ b/.github/workflows/windows-runtime.yml
@@ -0,0 +1,193 @@
+name: Project Constellation Windows Runtime Gate
+
+on:
+  workflow_call:
+  workflow_dispatch:
+  pull_request:
+    paths:
+      - 'desktop/**'
+      - 'extension/**'
+      - 'tests/**'
+      - 'tools/**'
+      - 'package.json'
+      - 'releases/v0.20.0/0.19.0-to-0.20.0.patch'
+      - 'releases/v0.20.0/SOURCE-MANIFEST.json'
+      - '.github/workflows/windows-runtime.yml'
+  push:
+    branches: ['release/**']
+    paths:
+      - 'releases/v0.20.0/0.19.0-to-0.20.0.patch'
+      - 'releases/v0.20.0/SOURCE-MANIFEST.json'
+      - '.github/workflows/windows-runtime.yml'
+
+permissions:
+  contents: read
+
+jobs:
+  windows-native:
+    runs-on: windows-latest
+    timeout-minutes: 65
+    steps:
+      - uses: actions/checkout@v7
+
+      - name: Reconstruct exact 0.20 source lineage
+        shell: pwsh
+        run: |
+          $ErrorActionPreference = 'Stop'
+          $PSNativeCommandUseErrorActionPreference = $true
+          $manifest = Get-Content 'releases/v0.20.0/SOURCE-MANIFEST.json' -Raw | ConvertFrom-Json
+          if ($manifest.version -ne '0.20.0') { throw "Unexpected source manifest version: $($manifest.version)" }
+          $baseline = [string]$manifest.baseline.artifact
+          $delta = [string]$manifest.delta.artifact
+          if (-not (Test-Path $baseline)) { throw "Baseline source archive missing: $baseline" }
+          if (-not (Test-Path $delta)) { throw "0.20 source delta missing: $delta" }
+          $baselineHash = (Get-FileHash $baseline -Algorithm SHA256).Hash.ToLowerInvariant()
+          $deltaHash = (Get-FileHash $delta -Algorithm SHA256).Hash.ToLowerInvariant()
+          if ($baselineHash -ne [string]$manifest.baseline.sha256) { throw "Baseline SHA mismatch: $baselineHash" }
+          if ($deltaHash -ne [string]$manifest.delta.sha256) { throw "Delta SHA mismatch: $deltaHash" }
+
+          Expand-Archive $baseline 'pc-source' -Force
+          Set-Location 'pc-source'
+          git init -q
+          git config user.name 'Project Constellation CI'
+          git config user.email 'actions@users.noreply.github.com'
+          git config core.autocrlf false
+          git add -A
+          git commit -q -m 'Project Constellation 0.19.0 production baseline'
+          git apply --cached '..\releases\v0.20.0\0.19.0-to-0.20.0.patch'
+          git checkout-index -a -f
+
+          $version = node -p "require('./package.json').version" 2>$null
+          if ($LASTEXITCODE -ne 0) {
+            $version = (Get-Content 'package.json' -Raw | ConvertFrom-Json).version
+          }
+          if ($version -ne '0.20.0') { throw "Reconstructed package version mismatch: $version" }
+          Set-Location '..'
+          $root = (Resolve-Path 'pc-source').Path
+          "PC_SOURCE_ROOT=$root" | Out-File -FilePath $env:GITHUB_ENV -Append -Encoding utf8
+          "PC_SOURCE_COMMIT=$($manifest.sourceCommit)" | Out-File -FilePath $env:GITHUB_ENV -Append -Encoding utf8
+          Write-Host "reconstructed_source=$root"
+          Write-Host "canonical_source_commit=$($manifest.sourceCommit)"
+
+      - uses: actions/setup-node@v7
+        with:
+          node-version: 24
+
+      - name: Root regression and contracts
+        shell: pwsh
+        run: |
+          $ErrorActionPreference = 'Stop'
+          $PSNativeCommandUseErrorActionPreference = $true
+          Set-Location $env:PC_SOURCE_ROOT
+          npm ci --no-audit --no-fund
+          npm test
+          npm run validate
+          npm run build:dev
+
+      - name: Install exact desktop dependencies
+        shell: pwsh
+        run: |
+          $ErrorActionPreference = 'Stop'
+          $PSNativeCommandUseErrorActionPreference = $true
+          Set-Location (Join-Path $env:PC_SOURCE_ROOT 'desktop')
+          npm install --no-audit --no-fund
+          $actual = (& .\node_modules\.bin\electron.cmd --version | Select-Object -Last 1).ToString().Trim()
+          if ($actual -ne 'v44.4.4') { throw "Electron mismatch: $actual" }
+          Write-Host "electron_runtime=$actual"
+
+      - name: Desktop full regression and native Windows computer use
+        shell: pwsh
+        run: |
+          $ErrorActionPreference = 'Stop'
+          $PSNativeCommandUseErrorActionPreference = $true
+          Set-Location (Join-Path $env:PC_SOURCE_ROOT 'desktop')
+          npm run check
+          npm test
+          node tests/computer-use-windows-smoke.mjs
+
+      - name: Real Electron integrated ChatGPT/local-agent smoke
+        shell: pwsh
+        run: |
+          $ErrorActionPreference = 'Stop'
+          $PSNativeCommandUseErrorActionPreference = $true
+          Set-Location (Join-Path $env:PC_SOURCE_ROOT 'desktop')
+          .\scripts\electron-smoke.ps1
+
+      - name: Build installer and portable ZIP
+        shell: pwsh
+        run: |
+          $ErrorActionPreference = 'Stop'
+          $PSNativeCommandUseErrorActionPreference = $true
+          Set-Location (Join-Path $env:PC_SOURCE_ROOT 'desktop')
+          npm run build:win
+
+      - name: Fresh portable launch and hash receipt
+        shell: pwsh
+        run: |
+          $ErrorActionPreference = 'Stop'
+          $PSNativeCommandUseErrorActionPreference = $true
+          $desktop = Join-Path $env:PC_SOURCE_ROOT 'desktop'
+          Set-Location $desktop
+          $zip = Get-ChildItem 'dist-electron' -Filter '*.zip' | Sort-Object Length -Descending | Select-Object -First 1
+          $setup = Get-ChildItem 'dist-electron' -Filter '*.exe' | Where-Object { $_.Name -notmatch 'uninstall' } | Sort-Object Length -Descending | Select-Object -First 1
+          if (-not $zip) { throw 'Portable ZIP not produced.' }
+          if (-not $setup) { throw 'Windows setup not produced.' }
+
+          $fresh = Join-Path $env:RUNNER_TEMP 'pc-portable-fresh'
+          Expand-Archive $zip.FullName $fresh -Force
+          $exe = Get-ChildItem $fresh -Filter 'Project Constellation.exe' -Recurse | Select-Object -First 1
+          if (-not $exe) { throw 'Project Constellation.exe missing from portable build.' }
+          $output = Join-Path $env:RUNNER_TEMP 'pc-packaged-smoke.json'
+          Remove-Item $output -Force -ErrorAction SilentlyContinue
+          $env:CONSTELLATION_ELECTRON_SMOKE = '1'
+          $env:CONSTELLATION_ELECTRON_SMOKE_OUTPUT = $output
+          $proc = Start-Process -FilePath $exe.FullName -PassThru
+          $deadline = (Get-Date).AddSeconds(60)
+          while (-not (Test-Path $output) -and (Get-Date) -lt $deadline) { Start-Sleep -Milliseconds 250 }
+          if (-not (Test-Path $output)) {
+            try { Stop-Process -Id $proc.Id -Force } catch {}
+            throw 'Packaged portable smoke timed out.'
+          }
+          $proof = Get-Content $output -Raw | ConvertFrom-Json
+          if ($proof.ok -ne $true -or $proof.detail.ok -ne $true -or $proof.detail.pong -ne $true -or $proof.detail.visibleLeak -ne $false) {
+            throw "Packaged smoke failed: $(Get-Content $output -Raw)"
+          }
+          try { if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force } } catch {}
+
+          $receipt = [ordered]@{
+            schema='project-constellation-windows-runtime-v1'
+            product='Project Constellation'
+            version='0.20.0'
+            sourceCommit=$env:PC_SOURCE_COMMIT
+            platform='windows-latest'
+            electron='44.4.4'
+            nativeComputerUse='PASS'
+            integratedElectron='PASS'
+            packagedPortable='PASS'
+            portableFile=$zip.Name
+            portableSize=$zip.Length
+            portableSha256=(Get-FileHash $zip.FullName -Algorithm SHA256).Hash.ToLowerInvariant()
+            setupFile=$setup.Name
+            setupSize=$setup.Length
+            setupSha256=(Get-FileHash $setup.FullName -Algorithm SHA256).Hash.ToLowerInvariant()
+          }
+          $receipt | ConvertTo-Json -Depth 5 | Set-Content 'dist-electron\WINDOWS-RUNTIME-RECEIPT.json' -Encoding utf8
+
+      - name: Stage stable Windows release artifacts
+        shell: pwsh
+        run: |
+          $ErrorActionPreference = 'Stop'
+          $PSNativeCommandUseErrorActionPreference = $true
+          $source = Join-Path $env:PC_SOURCE_ROOT 'desktop\dist-electron'
+          New-Item -ItemType Directory -Force 'windows-dist' | Out-Null
+          Copy-Item (Join-Path $source '*.zip') 'windows-dist' -Force
+          Copy-Item (Join-Path $source '*.exe') 'windows-dist' -Force
+          Copy-Item (Join-Path $source 'WINDOWS-RUNTIME-RECEIPT.json') 'windows-dist' -Force
+          Get-ChildItem 'windows-dist' | Select-Object Name,Length | Format-Table
+
+      - uses: actions/upload-artifact@v7
+        with:
+          name: Project-Constellation-v0.20.0-Windows
+          path: windows-dist/*
+          if-no-files-found: error
+          retention-days: 30
