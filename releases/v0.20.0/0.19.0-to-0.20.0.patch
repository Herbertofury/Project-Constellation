@@ -0,0 +1,82 @@
+name: Project Constellation Verify
+
+on:
+  workflow_call:
+  pull_request:
+  push:
+    branches: [main, 'release/**']
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  browser-and-core:
+    runs-on: ubuntu-latest
+    timeout-minutes: 35
+    steps:
+      - uses: actions/checkout@v7
+      - uses: actions/setup-node@v7
+        with:
+          node-version: 24
+      - uses: actions/setup-python@v7
+        with:
+          python-version: '3.12'
+
+      - name: Resolve exact source lineage
+        shell: bash
+        run: |
+          set -euo pipefail
+          root="$GITHUB_WORKSPACE"
+          manifest="$GITHUB_WORKSPACE/releases/v0.20.0/SOURCE-MANIFEST.json"
+          if [[ -f "$manifest" ]]; then
+            baseline=$(node -e "const fs=require('fs');const m=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.stdout.write(m.baseline.artifact)" "$manifest")
+            baseline_sha=$(node -e "const fs=require('fs');const m=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.stdout.write(m.baseline.sha256)" "$manifest")
+            delta=$(node -e "const fs=require('fs');const m=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.stdout.write(m.delta.artifact)" "$manifest")
+            delta_sha=$(node -e "const fs=require('fs');const m=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.stdout.write(m.delta.sha256)" "$manifest")
+            source_commit=$(node -e "const fs=require('fs');const m=JSON.parse(fs.readFileSync(process.argv[1],'utf8'));process.stdout.write(m.sourceCommit)" "$manifest")
+            [[ "$(sha256sum "$baseline" | awk '{print $1}')" == "$baseline_sha" ]]
+            [[ "$(sha256sum "$delta" | awk '{print $1}')" == "$delta_sha" ]]
+            root="$GITHUB_WORKSPACE/pc-source"
+            rm -rf "$root"
+            mkdir -p "$root"
+            unzip -q "$baseline" -d "$root"
+            git -C "$root" init -q
+            git -C "$root" config user.name 'Project Constellation CI'
+            git -C "$root" config user.email 'actions@users.noreply.github.com'
+            git -C "$root" config core.autocrlf false
+            git -C "$root" add -A
+            git -C "$root" commit -q -m 'Project Constellation verified production baseline'
+            git -C "$root" apply --cached "$GITHUB_WORKSPACE/$delta"
+            git -C "$root" checkout-index -a -f
+            [[ "$(node -p "require('$root/package.json').version")" == '0.20.0' ]]
+            echo "PC_SOURCE_COMMIT=$source_commit" >> "$GITHUB_ENV"
+          fi
+          echo "PC_SOURCE_ROOT=$root" >> "$GITHUB_ENV"
+          echo "exact_source_root=$root"
+
+      - run: python -m pip install -r "$PC_SOURCE_ROOT/requirements-dev.txt"
+      - run: python -m playwright install --with-deps chromium
+      - name: Browser, core, contracts, and development build
+        shell: bash
+        run: |
+          set -euo pipefail
+          cd "$PC_SOURCE_ROOT"
+          npm ci --no-audit --no-fund
+          npm run verify
+      - name: Desktop portable-runtime tests (non-native Windows paths)
+        shell: bash
+        run: |
+          set -euo pipefail
+          cd "$PC_SOURCE_ROOT/desktop"
+          npm install --no-audit --no-fund
+          npm run check
+          npm test
+      - uses: actions/upload-artifact@v7
+        if: failure()
+        with:
+          name: linux-smoke-evidence
+          path: |
+            logs/smoke/
+            pc-source/logs/smoke/
+          if-no-files-found: ignore
