+* { box-sizing: border-box; }
+html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: var(--bg); color: var(--text); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
+button, select, input { font: inherit; }
+button { border: 1px solid #334055; background: #1b2635; color: var(--text); border-radius: 8px; padding: 8px 10px; cursor: pointer; }
+button:hover { background: #24334a; }
+button:disabled { opacity: .5; cursor: not-allowed; }
+button.ghost { background: transparent; border-color: var(--line); }
+button.danger { background: #391419; border-color: #7f2730; color: #ffd7db; font-weight: 800; letter-spacing: .03em; }
+button.danger.locked { background: #8e1825; color: white; box-shadow: 0 0 0 2px rgba(255,100,100,.18) inset; }
+button.wide { width: 100%; }
+.topbar { position: fixed; inset: 0 0 auto 0; height: var(--top); display: flex; align-items: center; gap: 18px; padding: 0 12px 0 14px; background: #0d1118; border-bottom: 1px solid var(--line); z-index: 2; }
+.brand { display: flex; align-items: center; gap: 8px; min-width: 350px; }
+.brand-mark { color: var(--accent); font-size: 20px; }
+.top-status { display: flex; align-items: center; gap: 8px; flex: 1; color: #c9d2df; font-size: 13px; }
+.top-actions { display: flex; gap: 6px; }
+.sidebar { position: fixed; left: 0; top: var(--top); bottom: 0; width: var(--side); background: var(--panel); border-right: 1px solid var(--line); padding: 12px; overflow-y: auto; z-index: 2; }
+.sidebar section { background: var(--panel-2); border: 1px solid var(--line); border-radius: 11px; padding: 11px; margin-bottom: 10px; }
+.hero-card { background: linear-gradient(145deg, #142036, #111722) !important; }
+.eyebrow { color: var(--accent); font-size: 10px; font-weight: 800; letter-spacing: .16em; margin-bottom: 5px; }
+.hero-line { display: flex; gap: 8px; align-items: center; font-size: 15px; }
+.section-title { font-size: 12px; font-weight: 800; color: #dce5f0; margin-bottom: 9px; text-transform: uppercase; letter-spacing: .06em; }
+.row-between { display: flex; align-items: center; justify-content: space-between; }
+.field-label { display: block; font-size: 11px; color: var(--muted); margin-bottom: 5px; }
+select { width: 100%; padding: 8px; border-radius: 8px; border: 1px solid #334055; background: #0c1119; color: var(--text); margin-bottom: 7px; }
+.toggle-row, .check-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 32px; font-size: 12px; }
+.check-row { justify-content: flex-start; margin-top: 8px; }
+.switch { position: relative; width: 38px; height: 22px; flex: 0 0 auto; }
+.switch input { opacity: 0; width: 0; height: 0; }
+.switch span { position: absolute; inset: 0; border-radius: 99px; background: #343c48; transition: .15s; }
+.switch span::after { content: ''; position: absolute; width: 16px; height: 16px; left: 3px; top: 3px; border-radius: 50%; background: white; transition: .15s; }
+.switch input:checked + span { background: #3368b8; }
+.switch input:checked + span::after { transform: translateX(16px); }
+.badge { display: inline-flex; align-items: center; border: 1px solid #3b485c; background: #0c1119; border-radius: 99px; padding: 2px 7px; color: #b8c3d0; font-size: 10px; text-transform: none; letter-spacing: 0; }
+.badge.good { border-color: #27694d; color: #86e1b5; }
+.badge.warn { border-color: #725722; color: #f4c86e; }
+.badge.bad { border-color: #7c2e36; color: #ff9aa4; }
+.root-list { display: grid; gap: 5px; max-height: 126px; overflow: auto; margin-bottom: 8px; }
+.root { display: flex; align-items: center; gap: 5px; background: #0c1119; border: 1px solid #273140; border-radius: 7px; padding: 6px 7px; }
+.root code { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #cbd7e6; font-size: 10px; }
+.root button { padding: 2px 6px; border: 0; background: transparent; color: #aab6c5; }
+.button-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
+.small { font-size: 11px; }
+.muted { color: var(--muted); }
+.dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; background: #6c7582; box-shadow: 0 0 0 3px rgba(255,255,255,.03); }
+.dot-good { background: var(--good); }
+.dot-warn { background: var(--warn); }
+.dot-bad { background: var(--bad); }
+.activity-section { min-height: 180px; }
+.active-call { border: 1px solid #315e99; background: #0f223d; border-radius: 7px; padding: 7px; margin-bottom: 7px; font-size: 11px; }
+.hidden { display: none; }
+.activity { display: grid; gap: 5px; }
+.activity-item { border-left: 2px solid #3a4658; padding: 4px 6px; background: #0c1119; font-size: 10px; }
+.activity-item.ok { border-left-color: var(--good); }
+.activity-item.fail { border-left-color: var(--bad); }
+.activity-title { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: #dce4ee; }
+.activity-meta { color: var(--muted); margin-top: 2px; }
+footer { display: grid; gap: 6px; padding-bottom: 10px; }
+.chat-underlay { position: fixed; left: var(--side); top: var(--top); right: 0; bottom: 0; display: grid; place-items: center; background: #0b0d11; color: var(--muted); }
+.underlay-card { border: 1px dashed #2b3340; border-radius: 10px; padding: 14px 18px; font-size: 12px; }
+
+.desktop-preview { width: 100%; max-height: 205px; object-fit: contain; background: #07090d; border: 1px solid #273140; border-radius: 8px; margin-top: 8px; }
+.window-list { display: grid; gap: 5px; max-height: 210px; overflow: auto; margin-top: 8px; }
+.window-row { width: 100%; min-width: 0; display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 8px; text-align: left; background: #0c1119; border-color: #273140; padding: 6px 7px; }
+.window-row:hover { border-color: #45638b; background: #121b28; }
+.window-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 10px; color: #dce5f0; }
+.window-meta { font-size: 9px; color: var(--muted); white-space: nowrap; }
+.error-text { color: #ff9aa4; }
+
+.tool-note { margin: -2px 0 8px; line-height: 1.35; }
+.tool-filter, textarea { width: 100%; box-sizing: border-box; border: 1px solid #334055; background: #0c1119; color: var(--text); border-radius: 8px; }
+.tool-filter { padding: 8px; margin-bottom: 7px; }
+textarea { min-height: 88px; resize: vertical; padding: 8px; margin-bottom: 7px; font: 10px/1.45 ui-monospace, SFMono-Regular, Consolas, monospace; }
+.tool-help { min-height: 28px; margin: -2px 0 8px; line-height: 1.35; }
+.direct-status { margin-top: 7px; }
+.direct-result { max-height: 220px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; background: #080b10; border: 1px solid #273140; border-radius: 8px; padding: 8px; margin: 7px 0 0; color: #cbd7e6; font: 10px/1.45 ui-monospace, SFMono-Regular, Consolas, monospace; }
+
+body.sidebar-collapsed .sidebar { transform: translateX(-100%); pointer-events: none; }
+.sidebar { transition: transform .16s ease; }
+body.sidebar-collapsed .brand { min-width: 0; }
diff --git a/electron/shell.html b/electron/shell.html
new file mode 100644
